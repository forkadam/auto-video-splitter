{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vsplit",
  "version": "1.0.0",
  "identifier": "dev.forkadam.vsplit",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vsplit",
        "width": 1240,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; frame-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/windows-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/forkadam/auto-video-splitter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNTFEOEFBNTc5MjYyMTAKUldRUVlwSlhxdGhSTTFndFB6YlNORDFpcFFFRXFFS25DKzZPaEdVU3pIbGd5M1B2TWU3cnA5TXEK"
    }
  }
}
