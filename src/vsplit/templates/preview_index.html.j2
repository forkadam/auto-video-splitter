<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ slug }} — vsplit preview</title>
<style>
  /* Prettified thin scrollbar, matched to the dashboard's themed bars. */
  * { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.18) transparent; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background-color: rgba(255,255,255,0.16); border-radius: 9999px;
                              border: 2px solid transparent; background-clip: padding-box; }
  ::-webkit-scrollbar-thumb:hover { background-color: rgba(255,255,255,0.30); }
  ::-webkit-scrollbar-corner { background: transparent; }
  body { font-family: -apple-system, system-ui, sans-serif; margin: 1rem; background: #111; color: #eee; }
  h1 { font-size: 1.2rem; }
  .meta { color: #888; font-size: 0.9rem; margin-bottom: 1rem; }
  .scene { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px;
           border: 1px solid #333; padding: 8px; margin-bottom: 12px; }
  .scene-header { grid-column: 1 / -1; display: flex; justify-content: space-between;
                  font-size: 0.85rem; }
  .scene img { width: 100%; height: auto; display: block; }
  video { max-width: 100%; margin-top: 1rem; }
  .pill { padding: 2px 8px; border-radius: 6px; background: #333; }
</style>
</head>
<body>
<h1>{{ slug }}</h1>
<div class="meta">
  {{ scenes|length }} scenes{% if duration_label %} · {{ duration_label }}{% endif %} · source: {{ source_rel }}
</div>
{% if has_proxy %}
<video controls preload="metadata" src="{{ proxy_name }}"></video>
{% else %}
<video controls preload="metadata" src="../../../{{ source_rel | e }}"></video>
{% endif %}
<p style="font-size: 0.8rem; color: #666;">
  Source: <a href="../../../{{ source_rel | e }}" style="color: #888;">{{ source_rel }}</a>
  {% if has_proxy %}(proxy above; original linked for external player){% endif %}
</p>
{% for scene in scenes %}
<section class="scene" id="scene-{{ '%03d' % scene.id }}">
  <div class="scene-header">
    <span class="pill">#{{ scene.id }}</span>
    <span>
      cut at <strong>{{ scene.actual_start_tc }}</strong> → {{ scene.end_tc }}
      ({{ '%.2f' % scene.duration }}s)
      {% if scene.drift_seconds > 0.001 %}
        <span style="color: #888;">
          · detected {{ scene.start_tc }} (snapped back {{ '%.2f' % scene.drift_seconds }}s to keyframe)
        </span>
      {% endif %}
    </span>
  </div>
  {% for img in scene.images %}
    <img loading="lazy" src="images/{{ img }}" alt="scene {{ scene.id }} thumb">
  {% endfor %}
</section>
{% endfor %}
</body>
</html>
